{
  "name": "@easy-agent-gateway/agent-vue",
  "version": "0.1.0",
  "description": "Vue wrapper for Easy Agent Gateway chat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fzzf297/easy-agent-gateway.git",
    "directory": "frontend/packages/agent-vue"
  },
  "homepage": "https://github.com/fzzf297/easy-agent-gateway#readme",
  "bugs": "https://github.com/fzzf297/easy-agent-gateway/issues",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint src --ext .ts --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "dependencies": {
    "@easy-agent-gateway/agent-web": "workspace:*"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
