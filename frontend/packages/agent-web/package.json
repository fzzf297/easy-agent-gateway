{
  "name": "@easy-agent-gateway/agent-web",
  "version": "0.2.0",
  "description": "Framework-neutral web component for Easy Agent Gateway chat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fzzf297/easy-agent-gateway.git",
    "directory": "frontend/packages/agent-web"
  },
  "homepage": "https://github.com/fzzf297/easy-agent-gateway#readme",
  "bugs": "https://github.com/fzzf297/easy-agent-gateway/issues",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.cjs",
  "jsdelivr": "./dist/index.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint src tests --ext .ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc --emitDeclarationOnly"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jsdom": "29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@a2ui/lit": "0.10.2",
    "@a2ui/web_core": "0.10.5",
    "dompurify": "3.4.12",
    "lit": "3.3.3",
    "markdown-it": "14.3.0",
    "zod": "3.25.76"
  }
}
